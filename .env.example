# Gemini
GEMINI_API_KEY=

# Gmail OAuth (installed-app flow; refresh token minted once via scripts/gmail_oauth_setup.py)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Outlook / Microsoft Graph OAuth (Azure AD app; refresh token minted once via scripts/outlook_oauth_setup.py)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=
OUTLOOK_TENANT_ID=common

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets tracker
# Paste the full service-account JSON as a single line, or a path to the file locally.
GOOGLE_SERVICE_ACCOUNT_JSON=
TRACKER_SPREADSHEET_ID=
