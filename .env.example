# --- Stage 2: Gmail (required now) ---
# From Google Cloud Console -> Credentials -> OAuth client ID (Desktop app).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Minted once by: python -m scripts.gmail_oauth_setup
GMAIL_REFRESH_TOKEN=

# --- Later stages (leave blank until you get there) ---
# Stage 3+: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, but worth setting. Run `python -m scripts.list_models` to see what
# your key can reach. Two reasons to pin a model rather than ride the default
# `gemini-flash-latest` alias:
#   1. The alias moves between model generations with no commit on your side.
#      That has already changed both the required request format and the
#      available quota under this project once.
#   2. Free-tier DAILY request limits are per project per model, and the newest
#      flagship models get the stingiest ones (gemini-3.6-flash allows 20/day).
#      A lite model built for high-volume classification is both cheaper and
#      far more generous. Try gemini-2.5-flash-lite or gemini-2.0-flash-lite.
# Switching model also gives you a fresh daily allowance immediately, which is
# the quickest unblock when you have exhausted one.
GEMINI_MODEL=
# Optional. Requests/minute to stay under; free tier is single-digit.
# Note this paces per-MINUTE only — it cannot protect a per-day allowance.
GEMINI_RPM=

# Stage 6: from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stage 5: Google Sheets tracker.
#
# Set ONE of the two below.
#
# Locally, prefer the file path. The key you download from Google Cloud is
# pretty-printed across a dozen lines, and .env is line-based, so pasting it
# in as-is leaves the variable holding only "{".
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
#
# In CI, where secrets are strings and there is no file, use the inline form.
# It must be one line. Flatten the key with:
#   python -c "import json,sys;print(json.dumps(json.load(open(sys.argv[1]))))" key.json
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# From the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
TRACKER_SPREADSHEET_ID=
