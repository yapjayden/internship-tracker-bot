# --- Stage 2: Gmail (required now) ---
# From Google Cloud Console -> Credentials -> OAuth client ID (Desktop app).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Minted once by: python -m scripts.gmail_oauth_setup
GMAIL_REFRESH_TOKEN=

# --- Later stages (leave blank until you get there) ---
# Stage 3+: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Run `python -m scripts.list_models` to see what your key can use.
GEMINI_MODEL=
# Optional. Requests/minute to stay under; free tier is single-digit.
GEMINI_RPM=

# Stage 6: from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stage 5: Google Sheets tracker.
# Paste the full service-account JSON as a single line.
GOOGLE_SERVICE_ACCOUNT_JSON=
TRACKER_SPREADSHEET_ID=
